{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSINTAI Paradigm Entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "signals",
    "examples",
    "risks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
