{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ridd1kulusC0d3r/OSINTAI/schemas/tool.schema.json",
  "title": "OSINTAI Tool Catalog Entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "url",
    "category",
    "architecture",
    "protocols",
    "deployment",
    "local_first",
    "status",
    "verification",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "architecture": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deployment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "local_first": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "verified",
        "candidate",
        "archival",
        "rejected"
      ]
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
