{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSINTAI Curated Collection Entry",
  "type": "object",
  "required": [
    "id",
    "name",
    "url",
    "status",
    "focus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "enum": [
        "verified",
        "candidate",
        "archival",
        "rejected"
      ]
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
